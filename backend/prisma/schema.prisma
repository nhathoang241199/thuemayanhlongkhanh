// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Camera {
  id               String       @id @default(cuid())
  brand            CameraBrand
  name             String
  quantity         Int
  dayPrice         Int
  shiftPrice       Int
  purchasePrice    Int          @default(0)
  discountPercent  Int          @default(0)
  imageUrl         String?
  tutorialVideoUrl String?
  createdAt        DateTime     @default(now())
  bookings         Booking[]
  compatibleLenses CameraLens[]
  targetedPromotions ShopPromotion[]
}

model Lens {
  id                 String       @id @default(cuid())
  name               String
  quantity           Int
  dayPrice           Int
  shiftPrice         Int
  purchasePrice      Int          @default(0)
  discountPercent    Int          @default(0)
  imageUrl           String?
  createdAt          DateTime     @default(now())
  bookings           Booking[]
  compatibleCameras  CameraLens[]
}

model CameraLens {
  cameraId String
  camera   Camera @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  lensId   String
  lens     Lens   @relation(fields: [lensId], references: [id], onDelete: Cascade)

  @@id([cameraId, lensId])
  @@index([lensId])
}

enum CameraBrand {
  FUJIFILM
  CANON
  DJI
}

model Customer {
  id                    String       @id @default(cuid())
  name                  String
  phone                 String       @unique
  facebookUrl           String?
  verificationImageUrls String[]      @default([])
  isVerified            Boolean      @default(false)
  customerTag           CustomerTag  @default(NORMAL)
  note                  String?
  bookings              Booking[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}

enum CustomerTag {
  NORMAL
  FRIENDLY
  VIP
  UNFRIENDLY
  BLACKLISTED
}

model Booking {
  id            String        @id @default(cuid())
  bookingCode   String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  cameraId      String
  camera        Camera        @relation(fields: [cameraId], references: [id])
  lensId        String?
  lens          Lens?         @relation(fields: [lensId], references: [id])
  startBookingDate DateTime
  endBookingDate   DateTime
  slot             BookingSlot
  pickupAt         DateTime?
  returnNextMorning Boolean      @default(false)
  amount        Int
  discountPercent Int           @default(0)
  note          String?
  shippingAddress String?
  returnAddress  String?
  pendingChange Json?
  contractCccd       String?
  collateralMethod   CollateralMethod?
  collateralImageUrl String?
  paymentStatus PaymentStatus @default(PENDING)
  status        BookingStatus @default(PENDING_PAYMENT)
  payment       Payment?
  shipOrders ShipOrder[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([cameraId, startBookingDate])
  @@index([pickupAt])
}

model Payment {
  id           String              @id @default(cuid())
  bookingId    String              @unique
  booking      Booking             @relation(fields: [bookingId], references: [id])
  provider     String
  amount       Int
  status       PaymentRecordStatus @default(PENDING)
  providerTxnRef  String              @unique
  externalTransId String?
  rawPayload   Json?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

enum PaymentRecordStatus {
  PENDING
  SUCCESS
  FAILED
}

enum BookingSlot {
  FULL_DAY
  MORNING
  AFTERNOON
  EVENING
}

enum CollateralMethod {
  STUDENT_CARD_AND_CCCD
  CCCD_AND_2M
  HALF_VALUE
}

enum PaymentStatus {
  PENDING
  DEPOSITED
  PAID
  FAILED
  REFUNDED
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  RENTING
  COMPLETED
  PENDING_REFUND_CANCEL
  CANCELLED
}

model Expense {
  id          String   @id @default(cuid())
  title       String
  amount      Int
  note        String?
  expenseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
}

model ShopClosure {
  id        String   @id @default(cuid())
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([startDate, endDate])
}

model BookingTerms {
  id        String   @id @default("singleton")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

model ShopPromotion {
  id              String    @id @default("singleton")
  discountPercent Int       @default(0)
  startDate       DateTime? @db.Date
  endDate         DateTime? @db.Date
  targetCameraId  String?
  targetCamera    Camera?   @relation(fields: [targetCameraId], references: [id], onDelete: SetNull)
  updatedAt       DateTime  @updatedAt
}

model ShopInfo {
  id        String   @id @default("singleton")
  phone     String   @default("")
  address   String   @default("")
  mapUrl    String   @default("")
  latitude  Float?
  longitude Float?
  updatedAt DateTime @updatedAt
}

model ShopFeatures {
  id             String   @id @default("singleton")
  printEnabled   Boolean  @default(true)
  depositEnabled Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

model MessengerConversation {
  id            String                  @id @default(cuid())
  psid          String                  @unique
  handoffUntil  DateTime?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  messages      MessengerMessage[]
  learnExamples MessengerLearnExample[]
}

model MessengerLearnExample {
  id             String                @id @default(cuid())
  conversationId String
  conversation   MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userMessage    String
  ownerReply     String
  status         String                @default("pending")
  note           String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([conversationId, createdAt])
}

model MessengerMessage {
  id             String                @id @default(cuid())
  conversationId String
  conversation   MessengerConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
}

model FanpagePostDraft {
  id             String    @id @default(cuid())
  message        String
  link           String?
  publishPublic  Boolean   @default(true)
  status         String    @default("pending")
  source         String    @default("hermes")
  promotionNote  String?
  facebookPostId String?
  rejectNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?

  @@index([status, createdAt])
}

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String?
  content        String
  coverImageUrl  String?
  seoDescription String?
  status         String    @default("pending")
  source         String    @default("hermes")
  rejectNote     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  publishedAt    DateTime?

  @@index([status, publishedAt])
}

model Shipper {
  id                 String              @id @default(cuid())
  phone              String              @unique
  name               String
  passwordHash       String
  active             Boolean             @default(true)
  balanceVnd         Int                 @default(0)
  payoutQrUrl        String              @default("")
  payoutRequestedAt  DateTime?
  messengerPsid      String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  shipOrders         ShipOrder[]
  withdrawals        ShipperWithdrawal[]

  @@index([messengerPsid])
}

model ShipperWithdrawal {
  id        String   @id @default(cuid())
  shipperId String
  shipper   Shipper  @relation(fields: [shipperId], references: [id], onDelete: Cascade)
  amountVnd Int
  note      String?
  createdAt DateTime @default(now())

  @@index([shipperId, createdAt])
}

model ShipOrder {
  id            String    @id @default(cuid())
  bookingId     String
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingCode   String
  leg           String
  status        String    @default("PENDING")
  customerName  String
  customerPhone String
  address       String
  shipperId     String?
  shipper       Shipper?  @relation(fields: [shipperId], references: [id], onDelete: SetNull)
  claimedAt     DateTime?
  completedAt   DateTime?
  requestedAt   DateTime  @default(now())
  scheduleAt    DateTime?
  updatedAt     DateTime    @updatedAt

  @@unique([bookingId, leg])
  @@index([status, requestedAt])
  @@index([shipperId, status])
}
