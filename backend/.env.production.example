# Production — thuemayanhlongkhanh.com
# cp .env.production.example .env

PORT=3000
FRONTEND_ORIGIN=https://thuemayanhlongkhanh.com
FRONTEND_URL=https://thuemayanhlongkhanh.com

# Upload ảnh CCCD
# UPLOAD_DIR=/var/www/thuemayanhlongkhanh/backend/uploads
PUBLIC_API_URL=https://thuemayanhlongkhanh.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
ADMIN_JWT_SECRET=change-me-long-random-secret-min-16

DATABASE_URL=postgresql://app:CHANGE_ME@127.0.0.1:5432/app

# Chính sách buổi thuê — Bình Thạnh: chỉ Cả ngày (khớp NEXT_PUBLIC_BOOKING_SKIP_SLOT_STEP)
# BOOKING_ALLOWED_SLOTS=FULL_DAY

# Chính sách strict — cọc thế chân, upload ảnh thế chân theo đơn
# BOOKING_POLICY_MODE=strict

# SePay — https://thuemayanhlongkhanh.com/api/payments/sepay/webhook
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=

# --- Facebook Messenger bot ---
# Webhook: https://<domain>/api/messenger/webhook
MESSENGER_BOT_ENABLED=true
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# PSID admin nhận tin handoff (Graph API Explorer)
ADMIN_MESSENGER_PSID=

# --- Trợ lý AI admin ---
ADMIN_ASSISTANT_ENABLED=true
