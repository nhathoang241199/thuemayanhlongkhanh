# Server
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Upload ảnh CCCD (thư mục lưu file + URL công khai API)
# UPLOAD_DIR=./uploads
PUBLIC_API_URL=http://localhost:3000

# Admin (đổi mật khẩu trên production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
HERMES_API_KEY=generate-a-long-random-key
ADMIN_JWT_SECRET=change-me-at-least-16-chars

# Database (Prisma) — chỉnh cho khớp Postgres của bạn (vd. docker-compose: postgresql://app:app@localhost:5432/app)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/app

# --- SePay (chuyển khoản + webhook: https://developer.sepay.vn/en/sepay-webhooks ) ---
# API Key cấu hình trên SePay — gửi trong header Authorization khi webhook gọi vào
SEPAY_WEBHOOK_API_KEY=

# Telegram notification khi đơn được cọc thành công
TELEGRAM_BOT_TOKEN=
TELEGRAM_NEW_BOOKING_CHAT_ID=

# Tài khoản nhận tiền (hiển thị + VietQR)
SEPAY_BANK_BIN=
SEPAY_BANK_ACCOUNT=
SEPAY_ACCOUNT_NAME=
SEPAY_BANK_NAME=

# VietinBank API Banking: tiền tố bắt buộc đầu nội dung CK (mặc định SEVQR)
# SEPAY_VIETINBANK_PREFIX=SEVQR

# Ghi nhớ URL webhook đăng ký trên SePay (public HTTPS):
# POST https://thuemayanhlongkhanh.com/api/payments/sepay/webhook
# Production: xem backend/.env.production.example và docs/deploy-vps.md

# --- Facebook Messenger bot ---
# Webhook: https://<domain>/api/messenger/webhook
MESSENGER_BOT_ENABLED=true
# Chế độ học: bot không trả lời, ghi tin khách + câu shop trả trên Inbox (cần message_echoes)
MESSENGER_LEARN_MODE=false
# Gộp tin liên tiếp trước khi bot trả lời (ms)
MESSENGER_INACTIVITY_MS=10000
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=

# Web Push for /ship (npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@thuemayanhlongkhanh.com
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_APP_SECRET=
# Đăng bài fanpage qua Hermes agent (Graph API feed). Cần pages_manage_posts trên Meta app.
# FACEBOOK_PUBLISH_ENABLED=false

# Python AI service (chat khách — LangGraph + MiniMax)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TOKEN=dev-secret

# PSID admin nhận tin handoff (Graph API Explorer)
ADMIN_MESSENGER_PSID=
