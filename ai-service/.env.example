# Postgres (cùng backend/docker-compose)
DATABASE_URL=postgresql://app:app@localhost:5432/app

# MiniMax — chat
MINIMAX_API_KEY=
MINIMAX_MODEL=MiniMax-M2.5
MINIMAX_BASE_URL=https://api.minimax.io/v1
# MINIMAX_GROUP_ID=   # một số API key cần GroupId

# USE_LLM_AGENT=true   # bật lại MiniMax agent (mặc định tắt — câu không canned → chuyển admin)

# Shop context
FRONTEND_URL=http://localhost:3001

# Auth nội bộ (Nest gọi service)
AI_SERVICE_TOKEN=dev-secret

# CORS admin frontend
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
