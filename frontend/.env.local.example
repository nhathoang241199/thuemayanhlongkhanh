# Sao chép: cp .env.local.example .env.local
# Khởi động lại dev server sau khi đổi env.

# --- Mặc định: FE + API cùng máy (proxy → localhost:3000) ---
# NEXT_PUBLIC_API_URL=
# API_PROXY_TARGET=http://127.0.0.1:3000

# --- FE local, API VPS (khuyến nghị khi sửa UI với dữ liệu thật) ---
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=https://thuemayanhlongkhanh.com

# --- Gọi thẳng VPS (cần FRONTEND_ORIGIN trên VPS gồm http://localhost:3001; admin cookie khó dùng) ---
# NEXT_PUBLIC_API_URL=https://thuemayanhlongkhanh.com
