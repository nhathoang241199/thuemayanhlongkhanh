# Sao chép: cp .env.local.example .env.local
# Khởi động lại dev server sau khi đổi env.

# Branding địa điểm (mặc định Long Khánh nếu bỏ trống)
NEXT_PUBLIC_SITE_LOCATION_NAME=Long Khánh
NEXT_PUBLIC_STORE_MAP_URL=https://maps.app.goo.gl/p7E56GSttpufsQVx5

# Đặt lịch — Bình Thạnh: bỏ bước chọn buổi, mặc định cả ngày
# NEXT_PUBLIC_BOOKING_SKIP_SLOT_STEP=true
# NEXT_PUBLIC_BOOKING_DEFAULT_SLOT=FULL_DAY

# Chính sách strict — cọc thế chân, in hợp đồng mở rộng (Bình Thạnh)
# NEXT_PUBLIC_BOOKING_POLICY_MODE=strict

# --- Mặc định: FE + API cùng máy (proxy → localhost:3000) ---
# NEXT_PUBLIC_API_URL=
# API_PROXY_TARGET=http://127.0.0.1:3000

# --- FE local, API VPS (khuyến nghị khi sửa UI với dữ liệu thật) ---
NEXT_PUBLIC_API_URL=
API_PROXY_TARGET=https://thuemayanhlongkhanh.com

# --- Gọi thẳng VPS (cần FRONTEND_ORIGIN trên VPS gồm http://localhost:3001; admin cookie khó dùng) ---
# NEXT_PUBLIC_API_URL=https://thuemayanhlongkhanh.com
